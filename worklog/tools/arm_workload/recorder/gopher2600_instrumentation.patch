+// Recording of complete ARM program runs, for the PicoA10400 ARM-cartridge
+// work (tools/arm_carts). Not part of upstream Gopher2600.
+//
+// Every recorded call holds what a replaying interpreter needs to execute the
+// same ARM program and prove it got the same result: registers and flags on
+// entry, every writable memory segment before the call, the values of every
+// read that did not come from memory (LPC peripherals, e.g. Timer1) and every
+// call into the emulated Harmony driver (ARMinterrupt) together with the value
+// it returned, and then registers, flags, instruction count and every writable
+// segment after the call. The file layout is described in
+// tools/arm_carts/README.md; all integers are little endian.
+package arm
+
+import (
+	"encoding/binary"
+	"os"
+
+	"github.com/jetsetilly/gopher2600/coprocessor"
+)
+
+// RecFile, when non-nil, receives the recording. RecSelect decides, at the
+// start of each ARM program, whether this call is recorded (index = count of
+// programs started so far, frame = RecFrame as set by the harness).
+var RecFile *os.File
+var RecSelect func(index int, frame int) bool
+var RecFrame int
+var RecCalls, RecWritten int
+
+// DPC+ bus-side counters for choosing the targets of a DPC+ loop without an
+// ARM executor: CALLFUNCTION writes by value, fractional fetcher reads and
+// fast-fetch substitutions.
+var StatDPCPFn [256]uint64
+var StatDPCPFracRead, StatDPCPFastFetch uint64
+
+// StatMisaligned counts misaligned data accesses (the ARM7TDMI would rotate a
+// misaligned LDR; Gopher2600 aligns the address instead).
+var StatMisaligned uint64
+
+const (
+	recEvInterrupt = 1 // a: address of the BX, b: r2, c: r3, d: saveResult | reg<<8, e: value
+	recEvPeriph    = 2 // a: address, b: value read, c: access size in bytes
+)
+
+type recSeg struct {
+	origin   uint32
+	mem      *[]byte
+	writable bool
+}
+
+var recHeaderDone bool
+var recSegs []recSeg
+var recActive bool
+var recBuf []byte
+var recEvents [][6]uint32
+var recStartInstr uint64
+
+func recU32(b []byte, v uint32) []byte {
+	return binary.LittleEndian.AppendUint32(b, v)
+}
+
+// recFindSegments asks the cartridge's MapAddress for every 256-byte step of
+// the LPC2103 flash (512 KB) and SRAM (64 KB) windows and keeps each distinct
+// segment once. A segment is writable if MapAddress also returns it for a
+// write.
+func (arm *ARM) recFindSegments() {
+	seen := map[uint32]bool{}
+	scan := func(lo, hi uint32) {
+		for a := lo; a < hi; a += 0x100 {
+			mem, origin := arm.mem.MapAddress(a, false, false)
+			if mem == nil || seen[origin] {
+				continue
+			}
+			seen[origin] = true
+			wmem, _ := arm.mem.MapAddress(a, true, false)
+			recSegs = append(recSegs, recSeg{origin: origin, mem: mem, writable: wmem != nil})
+		}
+	}
+	scan(0x00000000, 0x00080000)
+	scan(0x40000000, 0x40010000)
+}
+
+func (arm *ARM) recFlags() uint32 {
+	var f uint32
+	if arm.state.status.negative {
+		f |= 1 << 31
+	}
+	if arm.state.status.zero {
+		f |= 1 << 30
+	}
+	if arm.state.status.carry {
+		f |= 1 << 29
+	}
+	if arm.state.status.overflow {
+		f |= 1 << 28
+	}
+	return f
+}
+
+func (arm *ARM) recWritable(b []byte) []byte {
+	for _, s := range recSegs {
+		if s.writable {
+			b = append(b, (*s.mem)...)
+		}
+	}
+	return b
+}
+
+// recBegin is called when a new ARM program starts (registers just reset).
+func (arm *ARM) recBegin() {
+	index := RecCalls
+	RecCalls++
+	if RecFile == nil || RecSelect == nil || !RecSelect(index, RecFrame) {
+		return
+	}
+	if !recHeaderDone {
+		arm.recFindSegments()
+		h := []byte("ARMREC01")
+		h = recU32(h, uint32(len(recSegs)))
+		for _, s := range recSegs {
+			var fl uint32
+			if s.writable {
+				fl = 1
+			}
+			h = recU32(h, s.origin)
+			h = recU32(h, uint32(len(*s.mem)))
+			h = recU32(h, fl)
+		}
+		for _, s := range recSegs {
+			if !s.writable {
+				h = append(h, (*s.mem)...)
+			}
+		}
+		sp, lr, pc := arm.mem.ResetVectors()
+		h = recU32(h, sp)
+		h = recU32(h, lr)
+		h = recU32(h, pc)
+		RecFile.Write(h)
+		recHeaderDone = true
+	}
+	recActive = true
+	recEvents = recEvents[:0]
+	recStartInstr = StatInstructions
+	b := []byte("CALL")
+	b = recU32(b, uint32(index))
+	b = recU32(b, uint32(RecFrame))
+	for i := 0; i < 16; i++ {
+		v := arm.state.registers[i]
+		if i == rPC {
+			v = arm.state.registers[rPC] - 2 // the first instruction to execute
+		}
+		b = recU32(b, v)
+	}
+	b = recU32(b, arm.recFlags())
+	recBuf = arm.recWritable(b)
+}
+
+func recEvent(e [6]uint32) {
+	if recActive {
+		recEvents = append(recEvents, e)
+	}
+}
+
+// recEnd is called when Run() returns; only an ended program (or one that
+// failed) closes the record - a program yielding to the VCS mid-way continues
+// in the next Run().
+func (arm *ARM) recEnd() {
+	if !recActive {
+		return
+	}
+	var status uint32
+	switch arm.state.yield.Type {
+	case coprocessor.YieldProgramEnded:
+		status = 0
+	case coprocessor.YieldSyncWithVCS, coprocessor.YieldRunning:
+		return
+	default:
+		status = 1
+	}
+	b := recBuf
+	b = recU32(b, uint32(len(recEvents)))
+	for _, e := range recEvents {
+		for _, v := range e {
+			b = recU32(b, v)
+		}
+	}
+	for i := 0; i < 16; i++ {
+		b = recU32(b, arm.state.registers[i])
+	}
+	b = recU32(b, arm.recFlags())
+	b = binary.LittleEndian.AppendUint64(b, StatInstructions-recStartInstr)
+	b = recU32(b, status)
+	b = arm.recWritable(b)
+	RecFile.Write(b)
+	RecWritten++
+	recActive = false
+}
