+// Instrumentation for the PicoA10400 ARM-cartridge feasibility study
+// (tools/arm_carts). Counts data accesses by region: Flash (0x0xxxxxxx),
+// SRAM (0x4xxxxxxx) and anything else (LPC peripherals).
+var StatRomReads, StatRamReads, StatRamWrites, StatOtherAcc uint64
+var StatOtherAddr = map[uint64]uint64{}
+
+func StatAccess(addr uint32, kind byte) {
+	switch addr & 0xf0000000 {
+	case 0x00000000:
+		if kind == 'R' {
+			StatRomReads++
+		} else {
+			StatOtherAcc++
+		}
+	case 0x40000000:
+		if kind == 'R' {
+			StatRamReads++
+		} else {
+			StatRamWrites++
+		}
+	default:
+		StatOtherAcc++
+		StatOtherAddr[uint64(addr)<<8|uint64(kind)]++
+	}
+}
